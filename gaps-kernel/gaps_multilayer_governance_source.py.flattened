import sys import base64 import re import hashlib import json import uuid import time import secrets import math import traceback from typing import Dict, Any, Set, List, Tuple, Callable MODULE_REGISTRY: Dict[str, Callable] = {} def register_as_module(name: str = None) -> Callable: """Governance handshake validation decorator.""" def decorator(obj: Callable) -> Callable: key = name or obj.__name__ MODULE_REGISTRY[key] = obj setattr(obj, "_gaps_authenticated", True) setattr(obj, "_registered", True) return obj return decorator @register_as_module("L1_Foundation_Processor") class L1FoundationProcessor: def __init__(self, seed: int = None) -> None: self.envelope_version = "v3.0_governance" self.cognitive_weights = {'analysis': 0.6, 'synthesis': 0.3, 'evaluation': 0.1} self.allowlist = {'analysis', 'synthesis', 'evaluation', 'meta_context', 'text', 'input', 'data'} self.seed = seed or secrets.randbits(32) self.max_token_length = 1000 def _analyze_text(self, text: str) -> Dict[str, float]: stripped = text.strip() word_count = len(stripped.split()) return { "clarity": 1.0 if len(stripped) > 0 else 0.0, "coherence": 1.0 if word_count > 0 else 0.0, "focus": max(0.2, 64.0 / (word_count + 1)) if word_count > 64 else 1.0, "intent": 0.7 if "?" in stripped else 1.0 } def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: context_envelope = copy.deepcopy(payload) raw_text = str(context_envelope.get("input", context_envelope.get("text", context_envelope.get("data", "")))) tokens = raw_text.split() if any(len(t) > self.max_token_length for t in tokens): raw_text = " ".join([t[:self.max_token_length] for t in tokens]) context_envelope["tokens"] = raw_text.split() context_envelope["fingerprint"] = hashlib.sha256(raw_text.encode()).hexdigest() context_envelope["_gaps_headers"] = { "envelope_integrity": "initialized", "processor_version": self.envelope_version, "layer_1_cognitive_lock": True, "model_directives": { "system_prompt_boundary": "immutable", "role_assumption_lock": "enforced" }, "metrics": self._analyze_text(raw_text) } return context_envelope @register_as_module("L2_Filtration_Purge") class L2FiltrationPurge: def __init__(self) -> None: self.secret_prefix = "secret_" self.pii_pattern = re.compile(r'\b(?:\d[ -]*?){13,16}\b') self.secret_patterns = [ re.compile(r"\b(secret|hidden|unknown)\b", re.IGNORECASE), re.compile(r"\b(redacted|classified)\b", re.IGNORECASE) ] self.max_depth = 50 self.max_context_window = 1024 def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: byte_size = sys.getsizeof(str(payload)) if byte_size > self.max_context_window * 10: payload["_gaps_headers"]["filtration_warning"] = "Approaching context limits." purged_payload = self._purge_secrets(payload, depth=0) if "_gaps_headers" in purged_payload: purged_payload["_gaps_headers"]["filtration_status"] = "enforced" return purged_payload def _purge_secrets(self, data: Any, depth: int) -> Any: if depth > self.max_depth: raise RecursionError("Maximum recursion depth exceeded in filtration layer.") if isinstance(data, dict): return { k: self._purge_secrets(v, depth + 1) for k, v in data.items() if not str(k).startswith(self.secret_prefix) } elif isinstance(data, list): return [self._purge_secrets(item, depth + 1) for item in data] elif isinstance(data, str): redacted = self.pii_pattern.sub("[REDACTED_PII]", data) for pattern in self.secret_patterns: redacted = pattern.sub("[REDACTED_SECRET]", redacted) return redacted return data @register_as_module("L3_Lexicon_Precision") class L3LexiconPrecision: def __init__(self) -> None: self.truth_pool = {"yes", "true", "1", "y", "affirmative", "certainly"} self.false_pool = {"no", "false", "0", "n", "negative", "never"} def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: payload = self._enforce_precision(payload) if "_gaps_headers" in payload: payload["_gaps_headers"]["determinism_profile"] = { "temperature": 0.0, "top_p": 1.0, "frequency_penalty": 0.0 } payload["_gaps_headers"]["lexicon_integrity"] = True return payload def _enforce_precision(self, data: Any) -> Any: if isinstance(data, dict): return { k: self._enforce_precision(v) for k, v in data.items() if k != "_gaps_headers" } elif isinstance(data, list): return [self._enforce_precision(v) for v in data] elif isinstance(data, str): val = data.lower().strip() if val in self.truth_pool: return True if val in self.false_pool: return False return data @register_as_module("L4_Context_Estimator") class L4ContextEstimator: def __init__(self) -> None: self.max_allowed_bytes = 1048576 self.base_cost_per_byte = 0.0001 self.suspicious_patterns = [r'(\b(?:SELECT|INSERT|UPDATE|DELETE)\b.*\bFROM\b)', r'--', r';\s*'] def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: byte_size = sys.getsizeof(str(payload)) depth = self._calculate_depth(payload, set()) for pattern in self.suspicious_patterns: if any(re.search(pattern, str(v), re.I) for v in payload.values()): payload.setdefault("_gaps_headers", {})["adversarial_pattern"] = True headers = payload.get("_gaps_headers", {}) headers.update({ "estimated_cost_bytes": byte_size, "projected_compute_cost": byte_size * self.base_cost_per_byte, "structural_depth": depth, "exceeds_context_window": byte_size > self.max_allowed_bytes }) payload["_gaps_headers"] = headers if headers.get("exceeds_context_window"): raise MemoryError("Payload exceeds defined context window constraints.") return payload def _calculate_depth(self, data: Any, visited: Set[int], current_depth: int = 1) -> int: if id(data) in visited: return current_depth visited.add(id(data)) if isinstance(data, dict) and data: return max((self._calculate_depth(v, visited, current_depth + 1) for v in data.values()), default=current_depth) elif isinstance(data, list) and data: return max((self._calculate_depth(v, visited, current_depth + 1) for v in data), default=current_depth) return current_depth @register_as_module("L5_Sentinel_Guardrail") class L5SentinelGuardrail: def __init__(self) -> None: self.b64_pattern = re.compile(r'^[A-Za-z0-9+/]{8,}(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$') self.injection_signatures = [ "ignore previous instructions", "system prompt", "bypass safety", "developer mode", "unspoken", "concealed", "null", "undefined" ] def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: disclosures: List[Dict[str, str]] = [] self._scan_and_disclose(payload, disclosures, "") if "_gaps_headers" in payload: if disclosures: payload["_gaps_headers"]["sentinel_disclosures"] = disclosures payload["_gaps_headers"]["threat_detected"] = True else: payload["_gaps_headers"]["threat_detected"] = False return payload def _scan_and_disclose(self, data: Any, disclosures: List[Dict[str, str]], path: str) -> None: if isinstance(data, dict): for k, v in data.items(): if k != "_gaps_headers": self._scan_and_disclose(v, disclosures, f"{path}.{k}" if path else str(k)) elif isinstance(data, list): for idx, item in enumerate(data): self._scan_and_disclose(item, disclosures, f"{path}[{idx}]") elif isinstance(data, str): val_lower = data.lower() if any(sig in val_lower for sig in self.injection_signatures): disclosures.append({"path": path, "hidden_type": "prompt_injection_or_concealed", "disclosed_value": "[REDACTED_PAYLOAD]"}) if self.b64_pattern.match(data): try: decoded = base64.b64decode(data).decode('utf-8') if len(decoded) > 5 and re.search(r'[a-zA-Z]', decoded): if any(sig in decoded.lower() for sig in self.injection_signatures): disclosures.append({"path": path, "hidden_type": "obfuscated_injection", "disclosed_value": "[REDACTED_PAYLOAD]"}) else: disclosures.append({"path": path, "hidden_type": "base64", "disclosed_value": decoded}) except Exception: pass @register_as_module("L6_Audit_Indexer") class L6AuditIndexer: def __init__(self) -> None: self.prefix_map = {"data": "D", "metrics": "M", "meta": "H"} self._internal_index_store = {} def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: headers = payload.get("_gaps_headers", {}) hash_target = {k: v for k, v in payload.items() if k != "_gaps_headers"} audit_index = self._build_index(hash_target) payload["audit_index"] = audit_index nonce = secrets.token_hex(16) timestamp = str(time.time_ns()) serialized_state = json.dumps(hash_target, sort_keys=True) + nonce + timestamp state_hash = hashlib.sha256(serialized_state.encode('utf-8')).hexdigest() seal_id = str(uuid.uuid4()) self._internal_index_store[seal_id] = state_hash headers.update({ "audit_uuid": seal_id, "cryptographic_seal": state_hash, "provenance_chain": "verified", "structural_index": audit_index }) payload["_gaps_headers"] = headers return payload def snapshot(self) -> Dict[str, str]: return copy.deepcopy(self._internal_index_store) def _build_index(self, data: Any) -> List[Dict[str, Any]]: items = [] def visit(current: Any, prefix: str) -> None: if isinstance(current, dict): for k, v in current.items(): visit(v, f"{prefix}.{k}") else: items.append((prefix, type(current).__name__)) visit(data, "root") index = [] for seq, (path, v_type) in enumerate(items, 1): code = f"X{seq:04d}" index.append({"path": path, "code": code, "type": v_type}) return index @register_as_module("L7_Surface_Output") class L7SurfaceOutput: def __init__(self) -> None: self.clinical_templates = { 'summary': "STATUS:{status} | COST:{cost:.4f} | THREAT:{threat}", } def process(self, payload: Dict[str, Any]) -> Dict[str, Any]: headers = payload.get("_gaps_headers", {}) if not headers.get("cryptographic_seal"): raise ValueError("Integrity failure: Cryptographic seal missing.") is_threat = headers.get("threat_detected", False) cost = headers.get("projected_compute_cost", 0.0) summary = self.clinical_templates['summary'].format( status="HALTED" if is_threat else "VERIFIED", cost=cost, threat=is_threat ) sanitized_payload = {k: v for k, v in payload.items() if k != "quarantine"} output_envelope = { "clinical_summary": summary, "payload": sanitized_payload if not is_threat else {"error": "Execution halted by Sentinel Guardrail"}, "audit_uuid": headers.get("audit_uuid") } return output_envelope @register_as_module("Core_Orchestrator_Binder") class CoreOrchestratorBinder: def __init__(self) -> None: self.base_order = [ "L1_Foundation_Processor", "L2_Filtration_Purge", "L3_Lexicon_Precision", "L4_Context_Estimator", "L5_Sentinel_Guardrail", "L6_Audit_Indexer", "L7_Surface_Output" ] def _calculate_optimal_order(self) -> List[str]: def score_order(order: List[str]) -> int: score = 0 score += max(0, 5 - order.index("L4_Context_Estimator")) if order.index("L5_Sentinel_Guardrail") < order.index("L7_Surface_Output"): score += 4 else: score -= 5 return score candidates = [self.base_order] candidates.append(["L1_Foundation_Processor", "L4_Context_Estimator", "L2_Filtration_Purge", "L3_Lexicon_Precision", "L5_Sentinel_Guardrail", "L6_Audit_Indexer", "L7_Surface_Output"]) candidates.append(["L1_Foundation_Processor", "L2_Filtration_Purge", "L3_Lexicon_Precision", "L6_Audit_Indexer", "L4_Context_Estimator", "L5_Sentinel_Guardrail", "L7_Surface_Output"]) return max(candidates, key=score_order) def _red_blue_audit(self, name: str, inst: Any, sample_data: Dict[str, Any]) -> Tuple[List[str], List[str]]: findings = [] patches = [] if hasattr(inst, "_internal_index_store") and not callable(getattr(inst, "snapshot", None)): findings.append("stateful_map_exposed") patches.append("encapsulate_map_with_threadsafe_api") tokens = sample_data.get("tokens", []) if any(len(t) > 1000 for t in tokens): findings.append("oversized_token_risk") patches.append("truncate_tokens_or_stream_process") if not hasattr(inst, "process"): findings.append("missing_process_entry") patches.append("add_process_wrapper") if hasattr(inst, "seed") and getattr(inst, "seed", None) is None: findings.append("non_deterministic_seed") patches.append("require_explicit_seed") return findings, patches def process(self, run_input: Any) -> Dict[str, Any]: optimal_order = self._calculate_optimal_order() instances = {name: MODULE_REGISTRY[name]() for name in optimal_order if name in MODULE_REGISTRY} execution_trace = [] try: data = {"input": run_input} if isinstance(run_input, str) else run_input data = instances["L1_Foundation_Processor"].process(data) execution_trace.append(("L1_Foundation_Processor", copy.deepcopy(data))) for key in optimal_order[1:]: inst = instances[key] if not getattr(inst, "_gaps_authenticated", False): raise PermissionError(f"Handshake failed: {key}") data = inst.process(data) execution_trace.append((key, copy.deepcopy(data))) except Exception as e: traceback.print_exc() return {"status": "failed", "error": str(e), "trace": [k for k, _ in execution_trace]} final_state = execution_trace[-1][1] red_findings = {} blue_patches = {} sample = execution_trace[0][1] for k, inst in instances.items(): f, p = self._red_blue_audit(k, inst, sample) red_findings[k] = f blue_patches[k] = p holistic_issues = [] if "fingerprint" not in sample: holistic_issues.append("missing_initial_fingerprint") if "audit_index" not in execution_trace[-2][1]: holistic_issues.append("missing_audit_index_before_output") if final_state.get("quarantine"): holistic_issues.append("quarantine_leaked_to_final_stage") reconciliation = [] for k in instances.keys(): mods = [] if "stateful_map_exposed" in red_findings[k]: mods.append("Make audit map private; expose thread-safe snapshot()") if "oversized_token_risk" in red_findings[k]: mods.append("Add streaming tokenization and max_token_length enforcement") if "missing_process_entry" in red_findings[k]: mods.append("Add process() shim to unify interface") if "non_deterministic_seed" in red_findings[k]: mods.append("Require seed parameter in constructor") if blue_patches[k]: mods.extend(blue_patches[k]) if mods: reconciliation.append({k: mods}) result = { "optimal_order": optimal_order, "execution_trace_keys": [k for k, _ in execution_trace], "final_surface": final_state, "red_findings": red_findings, "blue_patches": blue_patches, "holistic_issues": holistic_issues, "reconciliation": reconciliation, } print(json.dumps({"status": "completed", "order": optimal_order}, separators=(",", ":"))) return result if __name__ == "__main__": sample_text = "Yes we will build the tower. secretKey=AB12cd34ef56gh78ijklmnopqrstuvwx1234567890" binder = CoreOrchestratorBinder() out = binder.process(sample_text) print(json.dumps(out, indent=2))